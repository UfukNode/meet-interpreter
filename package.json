{
  "name": "meet-interpreter",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Live two-way speech translation for Google Meet as a Chrome extension",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "watch": "node scripts/build.mjs --watch",
    "zip": "node scripts/build.mjs && cd dist && rm -f ../meet-interpreter.zip && zip -qrX ../meet-interpreter.zip . -x '.DS_Store'",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "node scripts/build.mjs && node test/e2e/run.mjs",
    "test:scenarios": "node scripts/build.mjs && node test/e2e/scenarios.mjs",
    "test:api": "node test/api/smoke.mjs",
    "test:free": "node test/api/free.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "ws": "^8.18.3"
  }
}
